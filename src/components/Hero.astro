---
// src/components/Hero.astro — pixel wordmark + taped paper collage.
import { site, socials, rolesByTheme } from '../data/site';
import { heroStats, heroChipsTech, heroChipsMarketing } from '../data/content';
---

<section class="hero" id="home">
  <div class="container">
    <div class="hero__grid">
      <!-- intro column -->
      <div class="hero__intro">
        <div class="hero__tags">
          <span class="sticker sticker--paper hero__tag">
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i> {site.location}
          </span>
          <span class="sticker sticker--mint hero__tag">
            <span class="pulse" aria-hidden="true"></span>
            <span id="hero-availability">{site.availability}</span>
          </span>
          <span class="sticker sticker--ink hero__tag hero__mode retro-label">
            <i class="fa-solid fa-circle-half-stroke" aria-hidden="true"></i>
            <span id="hero-mode-label">tech view</span>
          </span>
        </div>

        <p class="hero__kicker retro-label">
          <span class="hero__kicker-mark">//</span> {site.tagline}
        </p>

        <h1 class="hero__title">
          <span class="hero__line"><span class="hero__line-inner">Pravesh</span></span>
          <span class="hero__line hero__line--outline">
            <span class="hero__line-inner text-outline">Kumar</span>
          </span>
          <span class="hero__line">
            <span class="hero__line-inner">Shrestha<span class="dot-end">.</span></span>
          </span>
        </h1>

        <div class="hero__roles">
          <span class="hero__prompt" aria-hidden="true">$</span>
          <span
            class="hero__role-text"
            id="role-text"
            data-roles-tech={JSON.stringify(rolesByTheme.tech)}
            data-roles-marketing={JSON.stringify(rolesByTheme.marketing)}>UI / UX Designer</span>
          <span class="hero__caret" aria-hidden="true"></span>
        </div>

        <p class="hero__desc" data-pane="tech">
          I build digital products at the intersection of <span class="text-accent">design thinking</span>,
          <span class="text-accent">full-stack engineering</span> and
          <span class="text-accent text-accent--mint">growth strategy</span>.
          Currently COO at HIREO and UI Designer at PRESS1.
        </p>
        <p class="hero__desc" data-pane="marketing">
          I turn products into growth stories — <span class="text-accent">positioning</span>,
          <span class="text-accent text-accent--pink">campaign systems</span> and
          <span class="text-accent text-accent--mint">funnel analytics</span> that move
          real numbers, not just impressions.
        </p>

        <div class="hero__cta" id="hero-cta">
          <a href="#projects" class="btn" aria-label="View my work">
            <span class="btn__roll" data-label="View work"><span>View my work</span></span>
            <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
          </a>
          <a href="#contact" class="btn btn--paper" aria-label="Let's talk">
            <span class="btn__roll" data-label="Let's talk"><span>Let's talk</span></span>
          </a>
        </div>

        <div class="hero__socials" id="hero-socials">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="hero__social"
                aria-label={s.label}
              >
                <i class={s.icon} aria-hidden="true"></i>
              </a>
            ))
          }
        </div>

        <div class="hero__scroll">
          <i class="fa-solid fa-arrow-down" aria-hidden="true"></i> scroll to explore
        </div>
      </div>

      <!-- collage column -->
      <div class="hero__collage" id="hero-collage">
        <svg class="doodle doodle--star" data-parallax="0.05" style="top:-5%;left:58%;width:42px;height:42px" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0l2.4 9.6L24 12l-9.6 2.4L12 24l-2.4-9.6L0 12l9.6-2.4z" />
        </svg>

        <div class="polaroid collage__photo" data-parallax="0.09">
          <span class="tape tape--tl" aria-hidden="true"></span>
          <div class="polaroid__frame">
            <!-- tech shows the monochrome print, marketing the colour one -->
            <img
              data-pane="tech"
              src="/images/probs-bw.jpg"
              alt="Pravesh looking out over the Kathmandu valley from a viewpoint"
              width="968"
              height="1280"
              loading="eager"
              decoding="async"
            />
            <img
              data-pane="marketing"
              src="/images/probs-color.jpg"
              alt="Pravesh on a suspension bridge strung with prayer flags"
              width="731"
              height="1284"
              loading="eager"
              decoding="async"
            />
          </div>
          <p class="polaroid__caption">somewhere past Syabrubesi ✦</p>
        </div>

        <div class="window collage__card" data-parallax="0.03">
          <span class="tape tape--tr" aria-hidden="true"></span>
          <div class="window__bar">
            <span class="window__dots" aria-hidden="true">
              <i class="win-dot win-dot--r"></i><i class="win-dot win-dot--a"></i><i class="win-dot win-dot--g"></i>
            </span>
            <span class="window__title">profile.card</span>
          </div>
          <div class="window__body">
            <div class="collage__name">Pravesh Kumar</div>
            <div class="collage__role" id="collage-role">UI Designer &amp; COO</div>

            <div class="collage__chips" data-pane="tech">
              {heroChipsTech.map((chip) => <span class="tag">{chip}</span>)}
            </div>
            <div class="collage__chips" data-pane="marketing">
              {heroChipsMarketing.map((chip) => <span class="tag">{chip}</span>)}
            </div>
          </div>
        </div>

        <div class="note collage__note" data-parallax="0.12">
          currently building<br />
          <strong>PeerPicks ↗</strong>
        </div>

        <div class="window collage__stats" data-parallax="0.06">
          <div class="window__bar">
            <span class="window__dots" aria-hidden="true">
              <i class="win-dot win-dot--r"></i><i class="win-dot win-dot--a"></i><i class="win-dot win-dot--g"></i>
            </span>
            <span class="window__title">stats.txt</span>
          </div>
          <div class="window__body">
            <div class="collage__stats-grid">
              {
                heroStats.map((stat) => (
                  <div class="collage__stat">
                    <b class="counter" data-target={stat.target}>{stat.value}</b>
                    <span>{stat.label}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <div class="badge-spin collage__badge" aria-hidden="true">
          <svg class="badge-spin__ring" viewBox="0 0 136 136">
            <defs>
              <path id="badge-circle" d="M68,68 m-51,0 a51,51 0 1,1 102,0 a51,51 0 1,1 -102,0" />
            </defs>
            <text>
              <textPath href="#badge-circle" startOffset="0">
                OPEN TO WORK ✦ REMOTE ✦ LET'S TALK ✦
              </textPath>
            </text>
          </svg>
          <span class="badge-spin__core">
            <i class="fa-solid fa-asterisk"></i>
          </span>
        </div>

        <svg class="doodle doodle--pink" data-parallax="0.08" style="bottom:1%;left:2%;width:74px;height:46px" viewBox="0 0 74 46" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
          <path d="M5 8c11 19 29 24 55 19" />
          <path d="M45 21l15 6-12 11" />
        </svg>
      </div>
    </div>
  </div>
</section>
