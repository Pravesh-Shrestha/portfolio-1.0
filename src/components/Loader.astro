---
// src/components/Loader.astro — retro CRT boot screen.
// Every reading element is centred so the percentage reads as a progress
// readout rather than a stray number off to the left.
import { site } from '../data/site';

const BLOCKS = 22;
---

<div
  class="loader"
  id="loader"
  role="status"
  aria-live="polite"
  aria-label={`Loading the ${site.brand} portfolio`}
>
  <div class="loader__scan" aria-hidden="true"></div>

  <div class="loader__inner" id="loader-inner">
    <div class="loader__word" id="loader-word" data-text={site.brand}>{site.brand}</div>
    <div class="loader__sub">portfolio system · v2.0</div>

    <div class="loader__bar" id="loader-bar">
      {Array.from({ length: BLOCKS }, () => <span class="loader__block"></span>)}
    </div>

    <div class="loader__meta">
      <span class="loader__pct" id="loader-pct">0%</span>
      <span class="loader__status">
        <span id="loader-status">booting</span>
        <span class="loader__caret" aria-hidden="true"></span>
      </span>
    </div>
  </div>

  <div class="loader__taskbar" aria-hidden="true">
    <span class="loader__pill">▚&nbsp;{site.brand}</span>
    <span class="loader__pill">◉&nbsp;v2.0</span>
    <span class="loader__hint">click or press esc to skip</span>
  </div>

  <div class="loader__flash" id="loader-flash" aria-hidden="true"></div>
</div>
