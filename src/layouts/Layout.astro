---
// src/layouts/Layout.astro — document shell, SEO metadata and global chrome.
import '../styles/global.css';
import Cursor from '../components/Cursor.astro';
import Loader from '../components/Loader.astro';
import { site, socials } from '../data/site';

export interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = site.title, description = site.description, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://probs.dev');
const ogImage = new URL(site.ogImage, Astro.site ?? 'https://probs.dev');

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.brand,
  jobTitle: 'COO, UI Designer & Full-Stack Developer',
  url: canonical.origin,
  email: `mailto:${site.email}`,
  image: ogImage.href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kathmandu',
    addressCountry: 'NP',
  },
  sameAs: socials.map((social) => social.href),
  knowsAbout: [
    'UI/UX Design',
    'Full-Stack Development',
    'React',
    'Node.js',
    'Kotlin',
    'Growth Strategy',
    'Application Security',
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#0B0C10" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Apply the saved theme before first paint so the wrong theme never flashes. -->
    <script is:inline>
      try {
        if (localStorage.getItem('pravesh:perspective') === 'marketing') {
          document.documentElement.classList.add('mode-marketing');
        }
      } catch (error) {
        /* storage blocked — fall back to the dark tech theme */
      }
    </script>

    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Caveat:wght@600;700&family=Silkscreen:wght@400;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>

  <body>
    <!-- tech-theme particle field, painted behind everything -->
    <canvas class="fx-field" id="fx-field" data-pane="tech" aria-hidden="true"></canvas>

    <a class="skip-link" href="#main">Skip to content</a>

    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>

    <Loader />
    <Cursor />

    <slot />

    <!--
      The soundtrack lives here, parked off-screen: a real 200x200 embed (any
      smaller and YouTube refuses to stream), just never in view. The nav's
      Music button is the entire UI — see initMusic() in scripts/main.js.
    -->
    <div class="music-host" id="music-frame" aria-hidden="true"></div>

    <button class="to-top" id="to-top" type="button" aria-label="Back to top">
      <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
    </button>

    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
